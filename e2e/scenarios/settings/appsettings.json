{
  "AllowedHosts": "*",
  "DockerUi": {
    "DockerSocketPath": "/var/run/docker.sock",
    "PollIntervalSeconds": 2,
    "BaseUrl": "http://localhost",
    "Icons": [
      { "Image": "nginx", "Icon": "nginx-proxy-manager.svg" }
    ],
    "Apps": {
      "settings": { "Hidden": true },
      "vault": { "Hidden": true },
      "custom": {
        "Url": "http://localhost:8082",
        "Icon": "/icons/uptime-kuma.svg"
      }
    },
    "Order": ["beta", "alpha"]
  }
}
