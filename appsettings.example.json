{
  "AllowedHosts": "*",
  "DockerUI": {
    "DockerSocketPath": "/var/run/docker.sock",
    "PollIntervalSeconds": 5,
    "BaseUrl": "http://192.168.1.46:5000",
    "Icons": [
      { "Image": "myregistry/whatever", "Icon": "jellyfin.png" }
    ],
    "Apps": {
      "my-stack": { "Url": "http://192.168.1.46:3000", "Icon": "custom.png" }
    },
    "Shortcuts": [
      { "Name": "Home Assistant", "Url": "http://192.168.1.46:8123", "Icon": "home-assistant.svg" }
    ],
    "Order": ["my-stack"],
    "Lan": {
      "Subnet": "192.168.1.0/24",
      "Ports": [80, 443, 8123, 8080],
      "ProbeTimeoutMs": 400,
      "Mdns": true,
      "Excludes": ["192.168.1.1/32"]
    }
  }
}
