# Copy to .env (or export) to override appsettings in the API
DockerUi__DockerSocketPath=/var/run/docker.sock
DockerUi__PollIntervalSeconds=5
# Optional: single JSON settings file (baseUrl, icon mappings, per-app
# url/icon/hidden, app order). Path may be relative to the content root.
DockerUi__SettingsFile=/app/config/settings.json
