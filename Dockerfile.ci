# The CI container intentionally runs as root: ci.sh chowns the scenario
# settings files to the dashboard's uid 1000 and writes generated reports and
# build output into the bind-mounted checkout, which the runner user owns.
#
# NOSONAR
FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
        openjdk-21-jre-headless jq \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# SonarScanner for .NET (the JRE above is its engine; jq polls the quality gate).
RUN dotnet tool install --global dotnet-sonarscanner --version 12.1.0 \
    && ln -sf /root/.dotnet/tools/dotnet-sonarscanner /usr/local/bin/dotnet-sonarscanner

# Lighthouse CI, pinned here so ci.sh runs the installed `lhci` directly
# (npx's on-demand install is a supply-chain risk we don't want at run time).
RUN npm install -g --ignore-scripts @lhci/cli@0.16.0

# Docker CLI + compose plugin (the daemon socket is mounted by CI).
# The dotnet SDK image is Ubuntu-based, so the distro comes from /etc/os-release.
RUN install -m 0755 -d /etc/apt/keyrings \
    && . /etc/os-release \
    && curl -fsSL "https://download.docker.com/linux/${ID}/gpg" -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/${ID} ${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Google Chrome (Playwright launches it via Channel="chrome", so no browser download is needed).
RUN curl -fsSL -o /tmp/google-chrome-stable.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/google-chrome-stable.deb \
    && rm -f /tmp/google-chrome-stable.deb \
    && rm -rf /var/lib/apt/lists/*

# The repository is bind-mounted onto its own checkout path at run time
# (see ci.yml, -w + -v <workspace>:<workspace>), so the compose file volume
# sources the docker client sends resolve to the same paths on the host
# daemon when it starts the e2e scenario containers.
CMD ["bash", "ci.sh"]
